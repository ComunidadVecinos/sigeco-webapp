# Copy this file to '.env' for local development

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
DATABASE_URL=postgresql://postgres:postgres@db:5432/appdb?schema=public

# ---- Backend ----
NODE_ENV=development
# Required for signed session cookie (change in local setup).
SESSION_SECRET=change-this-local-session-secret
SESSION_TTL_DAYS=7
SESSION_SAMESITE=lax
SESSION_SECURE=false

# Optional overrides. These already have safe local defaults in docker-compose.yml.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# MAIL_FROM=no-reply@sigeco.local
# APP_PUBLIC_URL=http://localhost
